    },
    {
      "shot_id": "S05_SH02",
      "speaker_id": "TANG_XIA",
      "delivery": "on_screen",
      "text": "你又想看两条线。",
      "source_line": 589,
      "start_hint_s": 0.0,
      "end_hint_s": 1.6
    },
    {
      "shot_id": "S05_SH02",
      "speaker_id": "ZHOU_YE",
      "delivery": "on_screen",
      "text": "对。",
      "source_line": 593,
      "start_hint_s": 1.8,
      "end_hint_s": 2.1
    },
    {
      "shot_id": "S06_SH01",
      "speaker_id": "ZHOU_YE",
      "delivery": "on_screen",
      "text": "右廊可能一个，距离不确定。近点先打，我补近点。右边出声再转。",
      "source_line": 605,
      "start_hint_s": 0.0,
