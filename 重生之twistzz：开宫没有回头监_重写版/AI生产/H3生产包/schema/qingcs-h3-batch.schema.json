{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingcs.local/schema/qingcs-h3-batch.schema.json",
  "title": "QingCS MiniMax-H3 production manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "project_id",
    "project_root",
    "defaults",
    "registries",
    "chapters"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_root": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "required": [
        "model",
        "duration",
        "ratio",
        "output_root"
      ],
      "properties": {
        "model": {
          "const": "MiniMax-H3"
        },
        "duration": {
          "type": "integer",
          "minimum": 4,
          "maximum": 15
        },
        "ratio": {
          "enum": [
            "adaptive",
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ]
        },
        "style_lock": {
          "type": "string"
        },
        "global_negative": {
          "type": "string"
        },
        "post_text_policy": {
          "type": "string"
        },
        "output_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "registries": {
      "type": "object",
      "required": [
        "characters"
      ],
      "properties": {
        "characters": {
          "type": "string"
        },
        "scenes": {
          "type": "string"
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "chapter",
          "title",
          "storyboard"
        ],
        "properties": {
          "chapter": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "storyboard": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string"
          },
          "protagonist_id": {
            "type": "string"
          },
          "protagonist_ref_from_grid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    }
  }
}
